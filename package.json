{
  "name": "codex-remote-access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram remote UI for persistent Codex app-server sessions.",
  "scripts": {
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
