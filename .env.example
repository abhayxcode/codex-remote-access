TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional. Use this if npm cannot find codex on PATH.
CODEX_BIN=codex

# Optional. Defaults to the directory where you start the bot.
CODEX_DEFAULT_CWD=/absolute/path/to/repo

# Hard filesystem boundary for Telegram-controlled workdirs.
# The bot refuses to select, list, or resume sessions outside this directory.
CODEX_PARENT_DIR=/absolute/path/to/parent

# Optional Codex defaults.
CODEX_MODEL=
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX=workspace-write

# Telegram-specific response style. Use off to inherit normal Codex behavior.
CODEX_TELEGRAM_CAVEMAN_MODE=ultra

# Per-user Telegram update rate limit.
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_RATE_LIMIT_MAX_UPDATES=20
